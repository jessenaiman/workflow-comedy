      { "from": "human-resolution", "to": "case-closed" },
      { "from": "human-resolution", "to": "big-brain" }
    ],
    "requiredPaths": [
      { "from": "evidence", "to": "human-resolution" },
      { "from": "evidence", "to": "costello" },
      { "from": "manager-decision", "to": "human-resolution" },
      { "from": "human-resolution", "to": "case-closed" },
      { "from": "human-resolution", "to": "big-brain" }
    ]
