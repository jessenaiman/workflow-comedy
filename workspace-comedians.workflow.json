    { "id": "abbott-to-evidence", "from": "abbott", "to": "evidence", "label": "status plus proof", "role": "main", "variant": "security" },
    { "id": "done-to-human", "from": "evidence", "to": "human-resolution", "label": "DONE candidate", "role": "branch", "variant": "emphasis" },
    { "id": "failure-to-costello", "from": "evidence", "to": "costello", "label": "WRONG/BLOCKED: field plus evidence", "role": "error", "variant": "security" },
    { "id": "costello-to-packet", "from": "costello", "to": "correction-packet", "label": "smallest correction", "role": "return", "variant": "emphasis" },
    { "id": "packet-to-retry", "from": "correction-packet", "to": "abbott-retry", "label": "retry once", "role": "return", "variant": "security" },
    { "id": "retry-to-evidence", "from": "abbott-retry", "to": "retry-evidence", "label": "fresh proof", "role": "return", "variant": "default" },
    { "id": "evidence-to-recheck", "from": "retry-evidence", "to": "costello-recheck", "role": "return", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "id": "recheck-to-decision", "from": "costello-recheck", "to": "manager-decision", "label": "recheck result", "role": "branch", "variant": "emphasis" },
    { "id": "decision-to-human", "from": "manager-decision", "to": "human-resolution", "role": "branch", "variant": "emphasis" },
    { "id": "human-to-closed", "from": "human-resolution", "to": "case-closed", "label": "RESOLVED", "role": "main", "variant": "emphasis" },
    { "id": "human-to-new-round", "from": "human-resolution", "to": "big-brain", "label": "STILL BROKEN + required new evidence", "role": "error", "variant": "security", "width": 1.2 }
  ],
  "cards": [
    { "dot": "cyan", "title": "Theory-vs-test contract", "items": ["Big Brain bounds the task and proof before Abbott attempts it", "Evidence decides whether the candidate is DONE, WRONG, or BLOCKED", "A successful first attempt goes straight to human resolution"] },
    { "dot": "amber", "title": "One correction loop", "items": ["Costello activates only after a failed evidence check", "The packet names one failed field and the smallest correction", "Retry and recheck happen once before a manager decision"] },
    { "dot": "rose", "title": "Human-owned ending", "items": ["Resolved cases close and record the result", "Still-broken cases require new evidence before a new bounded round", "Comedy pressure never replaces proof or human authority"] }
  ]
