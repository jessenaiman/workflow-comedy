    { "id": "human-resolution", "lane": "human", "col": 4, "type": "external", "label": "Human resolution", "width": 160, "height": 68 },
    { "id": "case-closed", "lane": "human", "col": 5, "type": "backend", "label": "Case closed", "width": 150, "height": 68 }
