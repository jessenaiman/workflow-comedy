  "nodes": [
    { "id": "task-contract", "lane": "round", "col": 0, "type": "external", "label": "Task contract", "width": 150, "height": 68 },
    { "id": "big-brain", "lane": "round", "col": 1, "type": "backend", "label": "Big Brain", "width": 150, "height": 68 },
