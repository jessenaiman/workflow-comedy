      },
      {
        "id": "correction-loop",
        "label": "Correction loop",
        "focus": ["evidence", "costello", "correction-packet", "abbott-retry", "retry-evidence", "costello-recheck", "manager-decision"],
        "note": "WRONG or BLOCKED names one failed field, applies one correction, and rechecks it once."
      }
    ]
