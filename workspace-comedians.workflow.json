    { "id": "evidence", "lane": "round", "col": 3, "type": "security", "label": "Evidence gate", "width": 150, "height": 68 },
    { "id": "costello", "lane": "correction", "col": 4, "type": "external", "label": "Costello challenge", "width": 160, "height": 68 },
    { "id": "correction-packet", "lane": "correction", "col": 5, "type": "messagebus", "label": "Correction packet", "width": 160, "height": 68 },
