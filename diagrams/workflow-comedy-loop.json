    "views": [
      {
        "id": "real-work-first",
        "label": "Real work becomes material",
        "focus": ["task_list", "creative_cast", "sincere_prompt"],
        "note": "The audit list sets the minimum work; Creative hides the routine inside sincere prompts."
      },
      {
        "id": "attempt-loop",
        "label": "Attempt, prove, retry",
        "focus": ["worker_attempt", "evidence_check", "failure_beat", "attempt_ledger", "task_closed"],
        "note": "Workers aim to succeed. Only real failures earn another beat, with three attempts per task."
      },
      {
        "id": "earned-ending",
        "label": "Earn the ending",
        "focus": ["task_closed", "attempt_ledger", "more_tasks", "final_transcript"],
        "note": "Visit every audit task, preserve failures, then end with the unaltered transcript and verdicts."
      }
    ]
  },
  "lanes": [
    { "id": "real_work", "label": "Real Work Queue" },
    { "id": "creative", "label": "Creative — Private" },
    { "id": "workers", "label": "Office Workers — Unaware" },
    { "id": "proof", "label": "Review & Evidence" }
  ],
  "phases": [
    { "id": "prepare", "label": "Prepare one real task", "fromCol": 0, "toCol": 1 },
    { "id": "perform", "label": "Cast and attempt", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "prove", "label": "Prove, loop, or finish", "fromCol": 4, "toCol": 5, "variant": "dashed" }
