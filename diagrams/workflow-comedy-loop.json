    "allowedTerminals": ["final_transcript"],
    "requiredPaths": [
      { "from": "failure_beat", "to": "worker_attempt" },
      { "from": "attempt_ledger", "to": "final_transcript" },
      { "from": "more_tasks", "to": "task_list" }
    ]
  },
  "nodes": [
    { "id": "task_list", "lane": "real_work", "col": 0, "type": "database", "label": "1. Audit Task List", "sublabel": "real defects = minimum work", "tag": "not invented", "width": 166 },
    { "id": "creative_cast", "lane": "creative", "col": 1, "type": "backend", "label": "2. Creative Casts", "sublabel": "tightens task; hides bit", "tag": "user sees plan", "width": 166 },
    { "id": "sincere_prompt", "lane": "creative", "col": 2, "type": "messagebus", "label": "3. Sincere Prompt", "sublabel": "job + voice + proof", "tag": "no comedy words", "width": 166 },
    { "id": "worker_attempt", "lane": "workers", "col": 3, "type": "frontend", "label": "4. Worker Attempts", "sublabel": "tries to finish completely", "tag": "best effort", "width": 166 },
    { "id": "evidence_check", "lane": "proof", "col": 4, "type": "security", "label": "5. Reviewer Tests", "sublabel": "real path + named proof", "width": 166 },
    { "id": "failure_beat", "lane": "creative", "col": 4, "type": "messagebus", "label": "6. Failure Earns Beat", "sublabel": "error becomes instruction", "tag": "no filler", "width": 174 },
    { "id": "attempt_ledger", "lane": "proof", "col": 3, "type": "database", "label": "Attempt Ledger", "sublabel": "1/3 → 2/3 → 3/3", "width": 158 },
    { "id": "task_closed", "lane": "proof", "col": 5, "type": "database", "label": "Task Passes", "sublabel": "check it; preserve proof", "width": 158 },
    { "id": "more_tasks", "lane": "real_work", "col": 5, "type": "messagebus", "label": "More Audit Tasks?", "sublabel": "next task or ending", "width": 166 },
    { "id": "final_transcript", "lane": "creative", "col": 5, "type": "external", "label": "Punchline + Verdict", "sublabel": "unaltered transcript", "tag": "technical + user review", "width": 174 }
  ],
  "edges": [
    { "id": "list-cast", "from": "task_list", "to": "creative_cast", "label": "one protected task", "role": "main" },
    { "id": "cast-prompt", "from": "creative_cast", "to": "sincere_prompt", "label": "hidden casting", "variant": "emphasis", "role": "main" },
    { "id": "prompt-worker", "from": "sincere_prompt", "to": "worker_attempt", "label": "assign owner", "role": "main" },
    { "id": "worker-review", "from": "worker_attempt", "to": "evidence_check", "label": "claimed fix + proof", "role": "main" },
    { "id": "review-pass", "from": "evidence_check", "to": "task_closed", "label": "PASS", "variant": "emphasis", "role": "main" },
    { "id": "review-fail", "from": "evidence_check", "to": "failure_beat", "label": "FAIL", "variant": "security", "role": "error" },
    { "id": "beat-ledger", "from": "failure_beat", "to": "attempt_ledger", "label": "link error + next line", "variant": "security", "role": "error" },
    { "id": "ledger-retry", "from": "attempt_ledger", "to": "sincere_prompt", "label": "attempt < 3: tighten + reassign", "variant": "emphasis", "role": "return" },
    { "id": "ledger-failed", "from": "attempt_ledger", "to": "more_tasks", "label": "3/3: log FAIL; continue", "variant": "security", "role": "error", "fromSide": "right", "toSide": "right", "route": "outside-right" },
    { "id": "closed-next", "from": "task_closed", "to": "more_tasks", "label": "task complete", "role": "main" },
    { "id": "next-loop", "from": "more_tasks", "to": "task_list", "label": "YES: next audit task", "variant": "emphasis", "role": "return" },
    { "id": "next-ending", "from": "more_tasks", "to": "final_transcript", "label": "NO: all tasks visited", "variant": "emphasis", "role": "main" }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "The Comedy Loop",
      "items": [
        "Creative hides a speaking rhythm inside a professional prompt",
        "The worker tries to succeed and never sees the routine",
        "A real failure supplies the next instruction and comedy beat",
        "Early success ends immediately; never manufacture another beat"
      ]
    },
    {
      "dot": "cyan",
      "title": "The Earned Ending",
      "items": [
        "Three failed attempts exhaust one task; remaining tasks continue",
        "Any exhausted task forces TECHNICAL FAIL in the final verdict",
        "Dialogue remains exactly as the agents produced it",
        "User alone decides COMEDY PASS or REVISE"
      ]
    }
  ]
}
